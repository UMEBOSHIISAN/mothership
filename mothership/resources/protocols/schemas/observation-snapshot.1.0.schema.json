{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UMEBOSHIISAN/secretary-tui/schemas/observation-snapshot.1.0.schema.json",
  "title": "Secretary TUI observation snapshot 1.0",
  "description": "A sanitized local observation with no authority, execution, or freshness claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source_kind",
    "source_schema_version",
    "status",
    "summary",
    "authority_effect",
    "execution_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "source_kind": {"enum": ["governance-handoff", "router-manifest"]},
    "source_schema_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
      }
    },
    "authority_effect": {"const": false},
    "execution_effect": {"const": false}
  }
}
