{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UMEBOSHIISAN/mothership-router/src/mothership_router/schema/router-manifest.1.0.schema.json",
  "title": "Mothership Router dry-run manifest 1.0",
  "description": "A recommendation-only routing result with no authority or execution effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "capability",
    "status",
    "recommended_alias",
    "registry_sha256",
    "reasons",
    "authority_effect",
    "execution_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"}
      ]
    },
    "capability": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"}
      ]
    },
    "status": {
      "enum": [
        "invalid_input",
        "human_review_required",
        "no_ready_executor",
        "approval_required",
        "approved_dry_run"
      ]
    },
    "recommended_alias": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"}
      ]
    },
    "registry_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"}
    },
    "authority_effect": {"const": false},
    "execution_effect": {"const": false}
  }
}
