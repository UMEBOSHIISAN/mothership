#!/usr/bin/env python3
"""Closed, human-gated approval ceremony for Friend Mothership Core."""

from __future__ import annotations

import os
import pathlib
import sys
import typing

sys.dont_write_bytecode = True

_BIN_DIR = pathlib.Path(__file__).resolve().parent
_SOURCE_ROOT = _BIN_DIR.parent.parent
if str(_SOURCE_ROOT) not in sys.path:
    sys.path.insert(0, str(_SOURCE_ROOT))

from orchestration.lib import canonical, ledger  # noqa: E402


_OPTIONS = (
    "--ledger",
    "--alias",
    "--invocation-id",
    "--registry-sha256",
    "--task-sha256",
    "--prompt-sha256",
    "--scope-sha256",
    "--invocation-sha256",
    "--expires-at",
)
_EXIT_OK = 0
_EXIT_OPERATION = 1
_EXIT_REJECTED = 2


class _UsageError(Exception):
    pass


def _parse_argv(argv: object) -> dict[str, str]:
    if type(argv) is not list or any(type(item) is not str for item in argv):
        raise _UsageError
    if len(argv) != 1 + 2 * len(_OPTIONS) or argv[0] != "approve":
        raise _UsageError
    parsed: dict[str, str] = {}
    for index in range(1, len(argv), 2):
        option = argv[index]
        value = argv[index + 1]
        if option not in _OPTIONS or option in parsed or "=" in option:
            raise _UsageError
        parsed[option] = value
    if set(parsed) != set(_OPTIONS):
        raise _UsageError
    return parsed


def _ledger_path(value: str) -> pathlib.Path:
    path = pathlib.Path(value)
    if (
        not path.is_absolute()
        or value == "/"
        or "\x00" in value
        or os.path.normpath(value) != value
    ):
        raise _UsageError
    return path


def _write_error(stream: typing.TextIO, message: str) -> None:
    try:
        stream.write(message)
        stream.flush()
    except Exception:
        pass


def _write_result(stream: typing.TextIO, event: dict[str, object]) -> bool:
    try:
        stream.write(canonical.canonical_json_bytes(event).decode("utf-8") + "\n")
        stream.flush()
    except Exception:
        return False
    return True


def main(
    argv: list[str] | None = None,
    input_stream: typing.TextIO | None = None,
    output_stream: typing.TextIO | None = None,
    error_stream: typing.TextIO | None = None,
) -> int:
    """Run exactly one approval command without routing or launching."""

    arguments = list(sys.argv[1:]) if argv is None else argv
    source = sys.stdin if input_stream is None else input_stream
    sink = sys.stdout if output_stream is None else output_stream
    errors = sys.stderr if error_stream is None else error_stream
    try:
        parsed = _parse_argv(arguments)
        path = _ledger_path(parsed["--ledger"])
        binding = ledger.make_binding(
            parsed["--alias"],
            parsed["--invocation-id"],
            parsed["--registry-sha256"],
            parsed["--task-sha256"],
            parsed["--prompt-sha256"],
            parsed["--scope-sha256"],
        )
        if binding.invocation_sha256 != parsed["--invocation-sha256"]:
            raise _UsageError
    except (_UsageError, ledger.EventValidationError):
        _write_error(errors, "llm-seat: invalid arguments\n")
        return _EXIT_REJECTED

    try:
        event = ledger.approve_interactively(
            binding,
            parsed["--expires-at"],
            path,
            source,
            errors,
        )
    except ledger.EventValidationError:
        _write_error(errors, "llm-seat: invalid arguments\n")
        return _EXIT_REJECTED
    except ledger.CeremonyIOError:
        _write_error(errors, "llm-seat: approval ceremony failed\n")
        return _EXIT_OPERATION
    except ledger.LedgerError:
        _write_error(errors, "llm-seat: ledger operation failed\n")
        return _EXIT_OPERATION

    if not _write_result(sink, event):
        _write_error(errors, "llm-seat: result output failed\n")
        return _EXIT_OPERATION
    if event["event_type"] == "approval_granted":
        return _EXIT_OK
    return _EXIT_REJECTED


if __name__ == "__main__":
    raise SystemExit(main())
